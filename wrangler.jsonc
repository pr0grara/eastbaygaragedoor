{
  // Deploys OVER the existing worker that owns the eastbaygaragedoorrepair.com custom domain.
  // The domain is bound to the worker named "garage-bayarea" (verified via CF API), NOT
  // "eastbaygaragedoor" — renaming would orphan the domain on the old static-only worker and
  // break /api/lead. SITE_SLUG carries the portfolio slug for lead attribution.
  "name": "garage-bayarea",
  "compatibility_date": "2025-01-01",
  "main": "worker/index.js",
  "assets": { "directory": "./dist", "binding": "ASSETS", "not_found_handling": "404-page" },
  "r2_buckets": [ { "binding": "LEAD_FILES", "bucket_name": "arabuilds-lead-files" } ],
  "vars": {
    "SITE_SLUG": "eastbaygaragedoor",
    "COMPANY": "Garage Door Repairs",
    "ALERT_TO": "azbaghda@gmail.com",
    "ALERT_FROM": "Garage Door Repairs <onboarding@resend.dev>"
  }
}

---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE, tel } from '../config/site';
---
<BaseLayout
  title={`Page Not Found | ${SITE.company}`}
  description={`That page can’t be found. Call ${SITE.company} at ${SITE.phoneDisplay} or head back home.`}
  noindex={true}
>
  <section class="section">
    <div class="container" style="text-align:center; padding:64px 16px;">
      <h1>Page Not Found</h1>
      <p class="lead">Sorry — that page doesn’t exist or has moved.</p>
      <p style="margin-top:20px;">
        <a class="btn btn-call btn-lg" href={tel()}>📞 Call {SITE.phoneDisplay}</a>
      </p>
      <p style="margin-top:16px;"><a href="/">← Back to home</a></p>
    </div>
  </section>
</BaseLayout>

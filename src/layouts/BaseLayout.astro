---
import '@fontsource-variable/inter/wght.css'; // self-hosted Inter (no render-blocking 3rd-party request)
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { localBusiness } from '../lib/schema';
import { SITE, tel } from '../config/site';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  /** Extra page-specific JSON-LD (BreadcrumbList, Service, etc.) */
  jsonLd?: object | object[];
  /** Optimized hero image URL — preloaded as the LCP image when provided. */
  heroImageUrl?: string;
}

const { title, description, noindex = false, jsonLd, heroImageUrl } = Astro.props;
const siteBase = Astro.site ?? new URL('https://example.com');
const canonical = new URL(Astro.url.pathname, siteBase).href;
const extra = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const schemas = [localBusiness(siteBase.href), ...extra];

// Absolute og:image URL (social-share card).
const ogBase = (Astro.site?.href ?? SITE.url).replace(/\/$/, '');
const ogImageUrl = SITE.ogImage
  ? SITE.ogImage.startsWith('http')
    ? SITE.ogImage
    : `${ogBase}${SITE.ogImage}`
  : '';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {heroImageUrl && <link rel="preload" as="image" href={heroImageUrl} fetchpriority="high" />}
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta property="og:site_name" content={SITE.company} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    {
      ogImageUrl && (
        <>
          <meta property="og:image" content={ogImageUrl} />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
          <meta property="og:image:alt" content={`${SITE.company} — ${SITE.trade} in ${SITE.region}`} />
        </>
      )
    }
    <meta name="twitter:card" content={ogImageUrl ? 'summary_large_image' : 'summary'} />
    {ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}
    <meta name="theme-color" content="#0f2741" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {schemas.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  </head>
  <body>
    <Header />
    <slot />
    <Footer />
    <a class="mobile-call-bar" href={tel()} aria-label={`Call ${SITE.phoneDisplay}`}>
      📞 Call {SITE.phoneDisplay}
    </a>
    <style is:global>
      @media (max-width: 768px) {
        .mobile-call-bar {
          position: fixed; left: 0; right: 0; bottom: 0; z-index: 1000;
          display: flex; align-items: center; justify-content: center; gap: 8px;
          background: var(--green); color: #fff; font-weight: 700; font-size: 16px; letter-spacing: 0.2px;
          padding: 14px 16px calc(14px + env(safe-area-inset-bottom));
          text-decoration: none; box-shadow: 0 -1px 6px rgba(0, 0, 0, 0.18);
        }
        body { padding-bottom: 60px; }
      }
      @media (min-width: 769px) {
        .mobile-call-bar { display: none; }
      }
    </style>
  </body>
</html>

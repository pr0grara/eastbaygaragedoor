---
import { SITE, tel } from '../config/site';

interface Props {
  source?: string;
  heading?: string;
  sub?: string;
}
const {
  source = 'website',
  heading = 'Get a Free Quote',
  sub = "Tell us what's going on — we'll call you right back.",
} = Astro.props;

// Turnstile sitekey — real Managed widget for eastbaygaragedoorrepair.com.
const TURNSTILE_SITEKEY = '0x4AAAAAAEGrDx2KR8JNWIIg';
---
<div class="card">
  <h2>{heading}</h2>
  <p class="card-sub">{sub}</p>
  <form id="lead-form" action="/api/lead" method="post" novalidate>
    <input type="hidden" name="source" value={source} />
    {/* Honeypot: bots fill this; humans never see it. */}
    <input type="text" name="company_website" style="display:none" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />

    <label for="name" class="lbl">
      <span class="lbl">Name *</span>
      <input type="text" name="name" autocomplete="name" required placeholder="Jane Doe" />
    </label>
    <label for="phone" class="lbl">
      <span class="lbl">Phone</span>
      <input type="tel" name="phone" autocomplete="tel" placeholder="(555) 123-4567" />
    </label>
    <label for="email" class="lbl">
      <span class="lbl">Email</span>
      <input type="email" name="email" autocomplete="email" placeholder="jane@email.com" />
    </label>
    <label for="message" class="lbl">
      <span class="lbl">How can we help?</span>
      <textarea name="message" rows="3" placeholder="e.g. broken spring, door won't open…"></textarea>
    </label>

    <div class="cf-turnstile" data-sitekey={TURNSTILE_SITEKEY} data-theme="light" style="margin:12px 0;min-height:65px;"></div>

    <button type="submit" class="btn btn-primary btn-lg btn-block">Get My Free Quote</button>
    <p class="form-status" id="form-status" role="status" aria-live="polite"></p>
    <p class="card-sub" style="text-align:center;margin:12px 0 0;font-size:.85rem;">
      or call <a href={tel()} style="color:var(--green-dark);font-weight:700;text-decoration:none;">{SITE.phoneDisplay}</a>
    </p>
  </form>
</div>

<script>
  const form = document.getElementById('lead-form') as HTMLFormElement | null;
  const statusEl = document.getElementById('form-status');
  const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

  function setStatus(msg: string, type: '' | 'error' | 'success') {
    if (!statusEl) return;
    statusEl.textContent = msg;
    statusEl.className = 'form-status' + (type ? ' ' + type : '');
  }

  let tsLoaded = false;
  let tsFailed = false; // the Turnstile script itself failed to load (content blocker, network)
  function loadTurnstile() {
    if (tsLoaded) return;
    tsLoaded = true;
    const st = document.createElement('script');
    st.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js';
    st.async = true;
    st.defer = true;
    st.onerror = () => { tsFailed = true; };
    document.head.appendChild(st);
  }
  form?.addEventListener('focusin', loadTurnstile, { once: true });

  // The spam check's answer, once it has one (Turnstile writes it into this hidden input).
  function turnstileToken(): string {
    const el = form?.querySelector('input[name="cf-turnstile-response"]') as HTMLInputElement | null;
    return (el && el.value) || '';
  }
  // Send waits for the spam check instead of racing it (LEADFIX-2026-10-05). Before, a tap that
  // beat the lazily loaded check posted with no token, and the Worker dropped it while this page
  // said "Thanks!". Waits up to 12 s (a slow phone, or a tap on the checkbox), then returns ''
  // so the caller sends anyway, marked, and the Worker keeps it flagged instead of losing it.
  async function waitForTurnstile(maxMs = 12000): Promise<string> {
    loadTurnstile();
    let tok = turnstileToken();
    if (tok) return tok;
    setStatus('One moment, checking you\u2019re not a robot. If a box appears above, tap it.', '');
    const until = Date.now() + maxMs;
    while (!tok && !tsFailed && Date.now() < until) {
      await new Promise((r) => setTimeout(r, 250));
      tok = turnstileToken();
    }
    setStatus('', '');
    return tok;
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    setStatus('', '');
    const fd = new FormData(form);
    const data = Object.fromEntries(fd.entries()) as Record<string, string>;

    if (data.company_website) return; // honeypot tripped — silently drop
    if (!data.name || !data.name.trim()) return setStatus('Please enter your name.', 'error');
    const phoneDigits = (data.phone || '').replace(/\D/g, '');
    if (phoneDigits.length < 10 && !EMAIL_RE.test((data.email || '').trim()))
      return setStatus('Please enter a valid phone number or email.', 'error');
  
    const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    const orig = btn.textContent;
    btn.disabled = true;
    btn.textContent = 'Submitting…';
    try {
      // Wait for the spam check (see waitForTurnstile), then send as multipart so the token and
      // any photo ride along. Still no token: send anyway with ts=blocked|unsolved, and the
      // Worker keeps it flagged 'unverified' rather than dropping it.
      const token = await waitForTurnstile();
      const send = new FormData(form);
      if (!token) send.set('ts', tsFailed || !(window as any).turnstile ? 'blocked' : 'unsolved');
      const res = await fetch('/api/lead', {
        method: 'POST',
        headers: { Accept: 'application/json' },
        body: send,
      });
      const out = await res.json().catch(() => ({ success: res.ok }));
      if (!res.ok || !out.success) throw new Error(out.message || 'bad status');
      form.reset();
      if ((window as any).turnstile) (window as any).turnstile.reset();
      setStatus(token
        ? "🎉 Thanks! We've received your request and will call you shortly."
        : "🎉 Thanks! We've received your request. If it's urgent, call us now.", 'success');
    } catch (err: any) {
      setStatus(err?.message || 'Sorry, something went wrong. Please call us instead.', 'error');
    } finally {
      btn.disabled = false;
      btn.textContent = orig;
    }
  });
</script>
